# "true"  -> simulador local (mockEngine)
# "false" -> backend real (por defecto)
EXPO_PUBLIC_USE_MOCK=false

# URL base del backend según el destino:
#   - Expo Web:           http://localhost:8080
#   - Emulador Android:   http://10.0.2.2:8080
#   - Dispositivo físico: http://192.168.x.x:8080 (IP local del PC en la misma Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Las variables EXPO_PUBLIC_* se inyectan en el build: tras cambiarlas,
# reinicia el servidor con `expo start -c` para limpiar la caché de Metro.
